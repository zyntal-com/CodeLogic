<Project>
  <!--
    Strong-name signing for every CodeLogic assembly (the same key in CodeLogic and CodeLogic.Libs; keep both copies identical).
    Public key token: 53a89305eedc5d98 (2048-bit RSA).

    - Every build signs. Local and CI builds public-sign with the committed public key (codelogic.public.snk),
      which gives the final assembly identity without the private key.
    - Release builds pass -p:CLStrongNameKeyFile=<path to the private .snk> (written from the repository secret
      CL_STRONG_NAME_KEY by release.yml) and are fully signed. The private key is never committed.
    - Opt a project out with <CLStrongName>false</CLStrongName> (before this file is imported, or on the command line).

    Strong naming is identity, not security (https://learn.microsoft.com/dotnet/standard/library-guidance/strong-naming).
  -->
  <PropertyGroup Condition="'$(CLStrongName)' != 'false'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="'$(CLStrongNameKeyFile)' == ''">$(MSBuildThisFileDirectory)codelogic.public.snk</AssemblyOriginatorKeyFile>
    <PublicSign Condition="'$(CLStrongNameKeyFile)' == ''">true</PublicSign>
    <AssemblyOriginatorKeyFile Condition="'$(CLStrongNameKeyFile)' != ''">$(CLStrongNameKeyFile)</AssemblyOriginatorKeyFile>
    <PublicSign Condition="'$(CLStrongNameKeyFile)' != ''">false</PublicSign>
    <!-- Friend assemblies are signed with the same key; StrongName.targets adds it to every InternalsVisibleTo. -->
    <CLPublicKey></CLPublicKey>
  </PropertyGroup>
</Project>
