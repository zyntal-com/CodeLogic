<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>CodeLogic</RootNamespace>
    <AssemblyName>CodeLogic</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Version is COMPOSED at build time, never hardcoded here.

        Major.Minor  ← repo-root version.txt (e.g. "4.8"), hand-controlled.
        Patch        ← the $(Patch) property. CI passes the GitHub run number
                       (-p:Patch=<run_number> or the whole -p:Version=...);
                       a local/dev build leaves it 0, giving a stable "4.8.0".

      CI publishes 4.8.<run_number>+<short-sha> (release) or
      4.8.<run_number>-preview+<short-sha> (prerelease). The run number is the
      monotonic, NuGet-orderable component (NuGet Patch is an Int32). The git
      sha is SemVer build-metadata: it is stripped by nuget.org and ignored for
      ordering, so it serves only as provenance — it survives in
      InformationalVersion.

      To move the line to 4.9, edit version.txt. Nothing else bumps it.

      AssemblyVersion / FileVersion are Win32 UInt16-per-field and cannot carry a
      -prerelease or +metadata suffix, so they are pinned to Major.Minor.0.0.
      That keeps CLR assembly binding fixed per minor version, so every patch
      loads interchangeably (no exact-patch binding demands on consumers).
    -->
    <_RootVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../version.txt').Trim())</_RootVersion>
    <Patch Condition="'$(Patch)' == ''">0</Patch>
    <!-- Set only when not supplied: CI's explicit -p:Version= still wins. -->
    <Version Condition="'$(Version)' == ''">$(_RootVersion).$(Patch)</Version>
    <!-- Strip any -prerelease / +metadata so these parse as numeric System.Version. -->
    <_CleanVersion>$(Version.Split('-')[0].Split('+')[0])</_CleanVersion>
    <AssemblyVersion>$([System.Version]::Parse($(_CleanVersion)).Major).$([System.Version]::Parse($(_CleanVersion)).Minor).0.0</AssemblyVersion>
    <FileVersion>$(_RootVersion).0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Authors>Zyntal.com</Authors>
    <Copyright>Copyright © 2026 Zyntal.com</Copyright>
    <Description>Modular .NET 11 framework with lifecycle-managed libraries, applications, and plugins. Zero external NuGet dependencies.</Description>
    <PackageId>CodeLogic</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zyntal-com/CodeLogic</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zyntal-com/CodeLogic</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>framework;modular;lifecycle;libraries;plugins;dotnet</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.nuget.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!--
    Populate PackageReleaseNotes from CHANGELOG.md so the "Release Notes" section on
    NuGet.org shows what changed (same as CodeLogic.Libs). NuGet rejects release notes
    over 35 000 characters, so long notes are cut back to a line boundary and point at
    the CHANGELOG.md that ships inside the package.
  -->
  <Target Name="_InjectChangelogIntoPackageReleaseNotes"
          BeforeTargets="GenerateNuspec"
          Condition="Exists('$(MSBuildThisFileDirectory)../CHANGELOG.md')">
    <PropertyGroup>
      <_ChangelogText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../CHANGELOG.md'))</_ChangelogText>
      <_ChangelogLimit>30000</_ChangelogLimit>
      <_ChangelogHead>$(_ChangelogText.Substring(0, $([System.Math]::Min($(_ChangelogLimit), $(_ChangelogText.Length)))))</_ChangelogHead>
      <_ChangelogTrimmed>$(_ChangelogHead.Substring(0, $([System.Math]::Max(0, $(_ChangelogHead.LastIndexOf('%0A'))))))</_ChangelogTrimmed>
      <PackageReleaseNotes Condition="$(_ChangelogText.Length) &lt;= $(_ChangelogLimit)">$(_ChangelogText)</PackageReleaseNotes>
      <PackageReleaseNotes Condition="$(_ChangelogText.Length) &gt; $(_ChangelogLimit)">$(_ChangelogTrimmed)

---

Release notes truncated to fit NuGet's 35 000 character limit. The complete changelog ships inside this package as CHANGELOG.md.</PackageReleaseNotes>
    </PropertyGroup>
  </Target>
  <!-- Treat warnings as errors for cleaner code -->
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>